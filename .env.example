# GhostDesk's environment contract — every variable the server reads, with its
# default. Nothing here is live: defaults live in code, this file documents
# them. Put real values in `.env.local` (gitignored) or on the process.
#
# Two variables may never come from a .env file — they select the cascade, so
# they exist before any file is read. The Justfile and the deployment set them
# on the process:
#   NESTRS_ENV_PREFIX=GHOSTDESK   renames every framework variable
#   GHOSTDESK_ENV                 picks which .env files load (default: development)

# --- auth — what the endpoint demands of a caller ---------------------------
# Bearer token required on every MCP operation. Mandatory when TLS is on (the
# boot refuses a TLS endpoint without it), dropped as cleartext when TLS is
# off. A secret: never commit a value for it.
# GHOSTDESK_AUTH__TOKEN=

# --- http — the transport ---------------------------------------------------
# The app pins loopback:3000 in code; override to bind elsewhere.
# GHOSTDESK_HTTP__HOST=127.0.0.1
# GHOSTDESK_HTTP__PORT=3000
# PEM certificate and key, read from a path. Unset means plain HTTP — and the
# auth posture follows: TLS ≡ auth.
# GHOSTDESK_HTTP__TLS_CERT_FILE=
# GHOSTDESK_HTTP__TLS_KEY_FILE=

# --- mcp — the endpoint ------------------------------------------------------
# Host-header allowlist (anti-DNS-rebinding). Defaults to loopback, so a
# deployment reached by name must name itself here.
# GHOSTDESK_MCP__ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- screen — the virtual display's geometry --------------------------------
# Must match the compositor's output, or every coordinate the agent computes
# lands in the wrong place.
# GHOSTDESK_SCREEN__WIDTH=1280
# GHOSTDESK_SCREEN__HEIGHT=1024

# --- idle — how long a desktop may sit untouched ----------------------------
# Seconds of MCP silence after which every application window is closed.
# 0 disables the watchdog.
# GHOSTDESK_IDLE__TIMEOUT_SECS=1800

# --- telemetry — when a session counts as over ------------------------------
# Seconds of silence after which a session is considered over and its summary
# is logged.
# GHOSTDESK_TELEMETRY__SESSION_IDLE_SECS=120

# --- logging -----------------------------------------------------------------
# Tracing filter (e.g. `info`, `debug,hyper=warn`).
# GHOSTDESK_LOG=info
# `json` (the release default) or `text` (the dev default).
# GHOSTDESK_LOG_FORMAT=text
# Append the emitting file:line to each event.
# GHOSTDESK_LOG_SOURCE_LOCATION=false
