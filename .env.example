# GhostDesk's environment contract — every variable the server reads, with its
# default. Nothing here is live: defaults live in code, this file documents
# them. Put real values in `.env.local` (gitignored) or on the process.
#
# Two variables may never come from a .env file — they select the cascade, so
# they exist before any file is read. The Justfile and the deployment set them
# on the process:
#   NESTRS_ENV_PREFIX=GHOSTDESK   renames every framework variable
#   GHOSTDESK_ENV                 picks which .env files load (default: development)

# --- auth — what the endpoint demands of a caller ---------------------------
# Bearer token required on every request the server answers. The boot refuses
# one posture outright — TLS with no token — and warns loudly about a second:
# a routable bind with no token, which the log names `exposed_open`. Leaving it
# unset is the dev posture; publishing the port in that posture hands the
# desktop to anything that can reach it.
# A secret: never commit a value for it.
# GHOSTDESK_AUTH__TOKEN=

# --- http — the transport ---------------------------------------------------
# The app pins loopback:3000 in code; override to bind elsewhere.
# GHOSTDESK_HTTP__HOST=127.0.0.1
# GHOSTDESK_HTTP__PORT=3000
# PEM certificate and key, read from a path. Unset means plain HTTP — and the
# auth posture follows: TLS ≡ auth.
# GHOSTDESK_HTTP__TLS_CERT_FILE=
# GHOSTDESK_HTTP__TLS_KEY_FILE=

# --- mcp — the endpoint ------------------------------------------------------
# Host-header allowlist (anti-DNS-rebinding). Defaults to loopback, so a
# deployment reached by name must name itself here.
# GHOSTDESK_MCP__ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- screen — the virtual display's geometry --------------------------------
# Must match the compositor's output, or every coordinate the agent computes
# lands in the wrong place.
# GHOSTDESK_SCREEN__WIDTH=1280
# GHOSTDESK_SCREEN__HEIGHT=1024

# --- idle — how long a desktop may sit untouched ----------------------------
# Seconds of MCP silence after which every application window is closed.
# 0 disables the watchdog.
# GHOSTDESK_IDLE__TIMEOUT_SECS=1800

# --- health — the two ceilings that bound a probe response -------------------
# Milliseconds, not seconds: a probe is scored against Kubernetes'
# `timeoutSeconds`, whose default is 1, so the only interval that matters here
# is under a second. Both indicators are cheap local IPC — a compositor
# roundtrip, a window-tree query — so the ceilings exist for the stalled case:
# they turn a hang into a named `down` the healthcheck can read, instead of a
# client-side timeout that says nothing about which seam went away.
# GHOSTDESK_HEALTH__INDICATOR_TIMEOUT_MS=750
# GHOSTDESK_HEALTH__PROBE_DEADLINE_MS=900

# --- logging -----------------------------------------------------------------
# Tracing filter (e.g. `info`, `debug,hyper=warn`). The default already carries
# the audit trail: every act on the desktop — key, pointer, capture, clipboard,
# launch — is logged at `info` by the service that performs it, with typed and
# copied text counted rather than quoted.
# Turning the whole filter up to `debug` undoes that: the MCP SDK then logs each
# request and response verbatim, secrets included. Keep `rmcp` out of it —
# `rmcp=warn` — as .env.development does.
# GHOSTDESK_LOG=info
# `json` (the release-profile default) or `text` (the dev default). Both carry
# the same fields, and every line carries the trace ids of the unit of work that
# emitted it — that is what ties an act to the call that asked for it, and it
# survives a line quoted on its own. JSON adds the sampling flag, which only a
# joined export makes sense of.
# GHOSTDESK_LOG_FORMAT=text
# Append the emitting file:line to each event.
# GHOSTDESK_LOG_SOURCE_LOCATION=false

# --- access log --------------------------------------------------------------
# One line per HTTP request on `nest_rs::operation` — method, path, status,
# duration, bytes, and the caller's address with how it was resolved. On by
# default, and it needs no collector: `/mcp` is served statelessly, so one
# request is one tool call and this is the per-call record.
# It governs that line only. The endpoint files a second one on the same target
# for the operation inside the request — which JSON-RPC method, whether it
# succeeded, how long it took — and no variable holds it: silence the family
# through the filter instead, by turning `nest_rs::operation` off there.
# GHOSTDESK_HTTP__ACCESS_LOG=true
# Reverse proxies whose `Forwarded` / `X-Forwarded-For` / `X-Real-IP` this
# deployment believes. Empty means every caller is identified by its transport
# peer — the one value a client cannot forge. Name the balancer here and the
# access log starts reporting the real client behind it.
# GHOSTDESK_HTTP__TRUSTED_PROXIES=
