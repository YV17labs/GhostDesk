# Secrets — TLS material, local agent state, MCP config
tls/
.claude/
.mcp.json

# Version control / CI / editor metadata
.git
.gitignore
.gitattributes
.github
.vscode
.devcontainer

# Rust build output. The builder stage compiles inside a cache mount, so a
# host `target/` would only bloat the context — and a directory built
# against the host's glibc has no business near the image anyway.
target

# Node (if any)
node_modules

# Docs and demos not needed inside the image
demos
docs

# OS junk
.DS_Store
Thumbs.db

# Docker-related files that don't belong inside the image context itself
**/.dockerignore
