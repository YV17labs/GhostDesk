# `RUST_LOG`, unprefixed: the console's filter is the ecosystem's variable, and a
# real `RUST_LOG` on the process outranks this one.
#
# `rmcp` is not named, and that is the point. The framework clamps the MCP SDK
# to nothing: below `warn` it quotes what a client sent — at `debug` the text
# `key_type` just typed and whatever `clipboard_set` was handed — and the
# endpoint already says every failure the SDK reported, on `nest_rs::mcp`,
# without the value. A directive naming `rmcp` replaces that clamp, so writing
# one here would open exactly what it closes.
#
# `nest_rs=debug` is kept for what it says at boot: the host allowlist, how the
# operations are gated, what the transport bound. None of it repeats per
# request.
RUST_LOG=info,nest_rs=debug,features=debug,platform=debug
# Off: a framework line would carry a registry path wider than the event
# itself, and the access line — the most read of them — would carry one on
# every request. Flip it back when the question is where a line came from.
GHOSTDESK_LOG_SOURCE_LOCATION=false
