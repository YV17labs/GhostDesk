# `rmcp=warn` is two filters at once, and neither is tidying.
#
# At `debug` the MCP SDK logs every request and response verbatim, which on
# this server means the text `key_type` just typed and whatever `clipboard_set`
# was handed. At `info` it narrates three lines of session lifecycle per
# operation — the `2026-07-28` revision is served statelessly, so every call
# opens and closes its own session — which on a real run was seven noise lines
# for every line worth reading. Everything the SDK reports as a *failure* is
# `warn` or above, so nothing an incident needs is filtered out.
#
# `nest_rs=debug` is kept for what it says at boot: the host allowlist, how the
# operations are gated, what the transport bound. None of it repeats per
# request.
GHOSTDESK_LOG=info,nest_rs=debug,features=debug,platform=debug,rmcp=warn
# Off: a framework line would carry a registry path wider than the event
# itself, and the access line — the most read of them — would carry one on
# every request. Flip it back when the question is where a line came from.
GHOSTDESK_LOG_SOURCE_LOCATION=false
